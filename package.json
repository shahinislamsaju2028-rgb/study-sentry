{
  "name": "study-sentry-tauri",
  "productName": "Study Sentry",
  "version": "4.3.5",
  "description": "Study Sentry v4.0 — Student productivity, Focus, Insights, Sprint Planner and Daily Tracker",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:web": "vite --config vite.config.standalone.ts",
