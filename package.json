    "build:web": "vite build --config vite.config.standalone.ts",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run-all.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "dist:win": "tauri build --bundles nsis",
    "test:hierarchy": "node tests/v52-hierarchy-check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "@tauri-apps/api": "^2.3.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-notification": "2.8.0",
    "@tauri-apps/plugin-opener": "2.7.2",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@tauri-apps/cli": "^2.3.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.0.9",
